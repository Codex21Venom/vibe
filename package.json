{
	"name": "vibe",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"frontend",
		"backend",
		"backend/functions",
		"docs",
		"cli",
		"mcp",
		"e2e"
	],
	"license": "MIT",
	"author": "adityabmv",
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^15.5.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"prepare": "husky",
		"start": "npx concurrently -n \"AI-SERVER,BACKEND,FRONTEND\" -c \"cyan,magenta,green\" \"python vibe-ai/src/main.py\" \"npm --workspace=backend run dev\" \"npm --workspace=frontend run dev\"",
		"binaries": "npx ts-node scripts/preload-mongo-binary.ts",
		"vibe": "npx ts-node cli/src/cli.ts"
	},
	"lint-staged": {
		"backend/**/*.{js,jsx,ts,tsx}": [
			"npm --workspace=backend run lint"
		]
	},
	"dependencies": {
		"vibe": "file:cli"
	},
	"allowScripts": {
		"core-js@2.6.12": true,
		"core-js@3.29.1": true,
		"core-js@3.49.0": true,
		"@firebase/util@1.12.1": true,
		"@google/genai@2.13.0": true,
		"@parcel/watcher@2.5.6": true,
		"@sentry-internal/node-cpu-profiler@2.4.1": true,
		"@sentry/cli@2.58.6": true,
		"@swc/core@1.15.43": true,
		"bcrypt@5.1.1": true,
		"core-js-pure@3.49.0": true,
		"esbuild@0.25.12": true,
		"mongodb-memory-server@10.4.3": true,
		"msw@2.15.0": true,
		"protobufjs@6.11.6": true,
		"protobufjs@7.6.5": true,
		"postman-code-generators@2.1.1": true,
		"sharp@0.32.6": true,
		"yarn@1.22.22": true
	}
}
